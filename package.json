{
  "name": "digital-legal-advisor",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "npm ci --prefix backend && npm ci --prefix frontend && npm run build --prefix frontend",
    "build:labor-law-data": "node backend/scripts/buildLaborLawDataset.js",
    "build:legal-reference-texts": "node backend/scripts/buildLegalReferenceTexts.js",
    "build:law-chunks": "node backend/scripts/buildLawChunks.js",
    "translate:ui": "node scripts/generate-ui-translations.mjs",
    "start": "npm start --prefix backend",
    "dev:backend": "npm start --prefix backend",
    "dev:frontend": "npm start --prefix frontend"
  }
}
